#!/usr/bin/env bash
# Runs the npm-installed claude, first installing it if this container has no
# working install yet (or waiting for an install already in progress).
set -eu

prefix="${NPM_CONFIG_PREFIX:-$HOME/.local/npm-global}"
if [ ! -e "$prefix/.verified" ]; then
  echo "Installing Claude Code (first use in this container; takes a few minutes)" >&2
  update-ai-clis --ensure
fi
exec "$prefix/bin/claude" "$@"
